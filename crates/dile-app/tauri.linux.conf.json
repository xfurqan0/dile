{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "panel",
        "title": "Dile",
        "width": 708,
        "height": 92,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "focus": false,
        "center": false
      }
    ]
  },
  "bundle": {
    "targets": ["deb", "rpm"],
    "linux": {
      "deb": {
        "depends": ["libasound2t64 | libasound2", "libstdc++6"],
        "files": {
          "/usr/lib/udev/rules.d/70-dile-input.rules": "../../packaging/linux/70-dile-input.rules"
        },
        "postInstallScript": "../../packaging/linux/post-install.sh"
      },
      "rpm": {
        "depends": ["libasound.so.2()(64bit)", "libstdc++.so.6()(64bit)"],
        "files": {
          "/usr/lib/udev/rules.d/70-dile-input.rules": "../../packaging/linux/70-dile-input.rules"
        },
        "postInstallScript": "../../packaging/linux/post-install.sh"
      }
    }
  }
}
