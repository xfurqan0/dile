{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dile",
  "version": "0.1.0",
  "identifier": "io.github.xfurqan0.dile",
  "build": {
    "frontendDist": "../../ui",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "panel",
        "title": "Dile",
        "width": 680,
        "height": 64,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": true,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Furkan Yıldız",
    "copyright": "Copyright (c) 2026 Furkan Yıldız",
    "licenseFile": "../../LICENSE",
    "category": "Productivity",
    "shortDescription": "Hold a key, speak, let go. Local Turkish-first dictation.",
    "longDescription": "Local, open-source push-to-talk dictation, Turkish first. Audio is processed in memory and never leaves the machine. What you said appears in a small panel for a moment, then lands in whatever you are typing in.",
    "resources": {
      "../../LICENSE": "LICENSE.txt",
      "../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "displayLanguageSelector": false,
        "languages": ["English", "Turkish"]
      }
    }
  }
}
